# Keep Unix line endings for files that run on Linux (bash, Docker, Cloud Build),
# even when the repo is checked out on Windows with core.autocrlf=true.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
deploy.sh text eol=lf
.env.example text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.csv -text
*.txt text eol=lf
data/sources/** -text
data/derived/** -text
