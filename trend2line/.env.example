# Copy to .env for local runs. Never commit .env.
# The app reads this file by itself when it starts, in any terminal (Git Bash, PowerShell, cmd, Mac, Linux).
# Values in quotes; comments on their own lines.

# 1 = canned Gemini outputs (trend data is still live). Use 0 with a key for live Gemini.
MOCK_LLM="1"

# 1 = no network at all; synthetic curves for tests/CI only.
OFFLINE="0"

# Current Flash model ID. Run: python -m scripts.smoke_gemini  to list what your key can use.
GEMINI_MODEL=""

# AI Studio key (starts AIza...) or Vertex AI express-mode key (starts AQ.); the type is auto-detected.
GOOGLE_API_KEY=""

# auto | ai_studio | vertex_express | vertex_adc
GEMINI_AUTH="auto"

# Only needed for vertex_adc
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"

# Identify yourself to Wikimedia; include a contact email.
WIKI_USER_AGENT="Trend2Line/0.2 (your-email@example.com)"

HTTP_CACHE_HOURS="12"
