# Copy to .env for local runs. Never commit .env. The app reads this file by itself in any terminal.
# Values in quotes; comments on their own lines.

# --- Gemini on Vertex AI (recommended; no API key) ---
# First run once:  gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"
# Pick one from: python -m scripts.smoke_gemini
GEMINI_MODEL=""

# --- Optional: an API key instead (AI Studio "AIza..." or Vertex express "AQ."); auto-detected ---
GOOGLE_API_KEY=""
# auto | ai_studio | vertex_express | vertex_adc
GEMINI_AUTH="auto"

# --- Google Cloud features (all on by default) ---
# Gemini + Google Search grounding to find real launches of any trend
ENABLE_GROUNDING="1"
# BigQuery Google Trends radar; hard cap on bytes billed per query
ENABLE_BIGQUERY="1"
BQ_MAX_GB="20"
# Run history: auto (Firestore on Cloud Run, local files on a laptop) | firestore | local | off
RUN_STORE="auto"

# --- Test switches: keep 0 for real use ---
# 1 = canned Gemini answers (automated tests only)
MOCK_LLM="0"
# 1 = no network at all, synthetic curves (automated tests only)
OFFLINE="0"

# Identify yourself to Wikimedia: must include a contact URL or email, or Wikimedia answers 403.
# Left empty, the app adds its public URL automatically.
WIKI_USER_AGENT=""
HTTP_CACHE_HOURS="12"
